# LLM providers (Stage 1). Leave empty to disable a provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Default provider and model for the pipeline: anthropic | openai | ollama.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# Fixtures (tests/fixtures/llm/<purpose>/). LLM_RECORD=1 records misses through the live provider;
# LLM_REPLAY=1 serves fixtures only and fails on a miss (what CI does).
LLM_RECORD=0
LLM_REPLAY=0

# Postgres 16 + pgvector from docker-compose (Stage 3). Host port 5433 avoids a local postgres on 5432.
DATABASE_URL=postgresql+psycopg://doc_intel:doc_intel@localhost:5433/doc_intel

# Production hardening (Stage 6)
# Comma-separated API keys accepted in the X-API-Key header. Empty = open API (local development only).
API_KEYS=
MAX_UPLOAD_MB=25
LOG_FORMAT=text                 # text | json
LOG_LEVEL=INFO
